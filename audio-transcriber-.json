    {
      "parameters": {
        "jsCode": "// Change 'text' to match the exact field name coming from your HTTP node\nconst fullText = $input.item.json.text || \"\"; \nconst maxLength = 4000; // Safe threshold under Telegram's 4096 limit\nconst chunks = [];\n\nif (fullText.length <= maxLength) {\n    // If it's already small enough, pass it through unchanged\n    return [{ json: { text: fullText } }];\n}\n\n// Split the text roughly by paragraphs or sentences so it doesn't break mid-word\nconst words = fullText.split(' ');\nlet currentChunk = \"\";\n\nfor (const word of words) {\n    // Check if adding the next word exceeds the max length\n    if ((currentChunk + \" \" + word).length > maxLength) {\n        chunks.push({ json: { text: currentChunk.trim() } });\n        currentChunk = word; // Start a new chunk with the current word\n    } else {\n        currentChunk += (currentChunk === \"\" ? \"\" : \" \") + word;\n    }\n}\n\n// Push the last remaining text chunk\nif (currentChunk.trim().length > 0) {\n    chunks.push({ json: { text: currentChunk.trim() } });\n}\n\nreturn chunks;\n"
      },
